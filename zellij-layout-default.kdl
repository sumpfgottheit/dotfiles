// Basis-Layout + Swap-Layouts.
//
// ACHTUNG: Sobald diese Datei existiert, ersetzt sie die eingebauten
// Swap-Layouts von Zellij vollstaendig. "vertical", "horizontal" und
// "stacked" sind daher unveraendert aus `zellij setup --dump-swap-layout
// default` uebernommen; "grid" ist neu und steht bewusst an erster Stelle,
// damit ein einzelnes Alt+d aus dem Basis-Layout direkt im Grid landet.
//
// Zykliert wird mit Alt+u (vorheriges) / Alt+d (naechstes).
//
// In einer Layout-Datei muessen tab_template und swap_tiled_layout INNERHALB
// des layout-Knotens stehen. Nur in einer separaten .swap.kdl-Datei stehen
// sie auf oberster Ebene -- so gibt `zellij setup --dump-swap-layout` sie aus.

layout {
    // default_tab_template statt tab_template name="ui": nur so bekommen auch
    // die zur Laufzeit per NewTab erzeugten Tabs Tab-Leiste und Statusleiste.
    // Ein benanntes Template greift ausschliesslich dort, wo es angefordert wird.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab {
        pane
    }

    // ACHTUNG: max_panes zaehlt die Plugin-Panes des Tab-Templates mit.
    // Tab-Leiste und Statusleiste sind je ein Pane, also gilt
    //     max_panes = sichtbare Panes + 2
    // Deshalb 4/6/8 fuer 2/4/6 echte Panes. Mit 2/4/6 griff bei vier Panes
    // faelschlich das 3x2-Raster und fuellte nur 3 + 1 statt 2x2.
    swap_tiled_layout name="grid" {
        tab max_panes=4 {
            pane split_direction="vertical" {
                pane
                pane
            }
        }
        tab max_panes=6 {
            pane {
                pane split_direction="vertical" { pane; pane; }
                pane split_direction="vertical" { pane; pane; }
            }
        }
        tab max_panes=8 {
            pane {
                pane split_direction="vertical" { pane; pane; pane; }
                pane split_direction="vertical" { pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="vertical" {
        tab max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        tab max_panes=8 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
                pane { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="horizontal" {
        tab max_panes=4 {
            pane
            pane
        }
        tab max_panes=8 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="stacked" {
        tab min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true { children; }
            }
        }
    }
}
